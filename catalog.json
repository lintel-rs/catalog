{
  "$schema": "https://json.schemastore.org/schema-catalog.json",
  "version": 1,
  "schemas": [
    {
      "name": "Claude Code Agent",
      "description": "Claude Code agent definition frontmatter",
      "url": "https://raw.githubusercontent.com/lintel-rs/catalog/master/schemas/claude-code/agent.json",
      "fileMatch": ["**/.claude/agents/*.md", ".claude/agents/*.md"]
    },
    {
      "name": "Claude Code Skill",
      "description": "Claude Code skill definition frontmatter",
      "url": "https://raw.githubusercontent.com/lintel-rs/catalog/master/schemas/claude-code/skill.json",
      "fileMatch": [
        "**/skills/*/SKILL.md",
        "**/skills/*.md",
        ".claude/skills/*.md"
      ]
    },
    {
      "name": "Claude Code Command",
      "description": "Claude Code slash command definition frontmatter",
      "url": "https://raw.githubusercontent.com/lintel-rs/catalog/master/schemas/claude-code/command.json",
      "fileMatch": [
        "**/.claude/commands/*.md",
        ".claude/commands/*.md",
        "**/commands/*.md"
      ]
    },
    {
      "name": "Claude Code Plugin",
      "description": "Claude Code plugin manifest",
      "url": "https://raw.githubusercontent.com/lintel-rs/catalog/master/schemas/claude-code/plugin.json",
      "fileMatch": [
        "**/.claude-plugin/plugin.json",
        ".claude-plugin/plugin.json"
      ]
    },
    {
      "name": "Claude Code Marketplace",
      "description": "Claude Code plugin marketplace catalog",
      "url": "https://raw.githubusercontent.com/lintel-rs/catalog/master/schemas/claude-code/marketplace.json",
      "fileMatch": [
        "**/.claude-plugin/marketplace.json",
        ".claude-plugin/marketplace.json"
      ]
    },
    {
      "name": "devenv.yaml",
      "description": "devenv configuration file",
      "url": "https://raw.githubusercontent.com/lintel-rs/catalog/master/schemas/devenv.json",
      "fileMatch": ["devenv.yaml", "**/devenv.yaml"]
    }
  ]
}
